# -----------------------------------------------------------------------
# This project currently has NO backend and NO live Jira API integration.
# The dashboard renders a JSON snapshot that is manually pasted into
# index.html (see README.md > "Updating the published snapshot").
# There is nothing to configure today — these variables are not read by
# any code in this repo.
#
# This file is a template for the OPTIONAL future backend described in
# SECURITY.md ("Recommended architecture"), in case the team later wants
# the dashboard to pull live data directly from Jira instead of a manually
# pasted snapshot. If/when that backend is built (e.g. a Cloudflare
# Worker or serverless function), copy this file to `.env` and fill in
# real values THERE — `.env` must never be committed (see .gitignore).
#
# Never put real credentials in this file. This file (.env.example) is
# committed to the repo as documentation; `.env` is not.
# -----------------------------------------------------------------------

# Jira Cloud site base URL, e.g. https://your-company.atlassian.net
JIRA_BASE_URL=

# Jira account email used with the API token below (Jira Cloud auth is
# email + API token, not a password)
JIRA_EMAIL=

# Jira API token — create at https://id.atlassian.com/manage-profile/security/api-tokens
# Server-side only. Never send this to the browser.
JIRA_API_TOKEN=

# --- Authentication (choose ONE provider and fill in only that section) ---

# Option A: Cloudflare Access (recommended — see SECURITY.md)
# No app-side secrets needed; Access is configured entirely in the
# Cloudflare dashboard and verified via the CF-Access-JWT-Assertion header
# your backend validates against these values.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Option B: Microsoft Entra ID (Azure AD) app registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Option C: Auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Restrict sign-in to your company's email domain, if your provider needs
# it configured on the app side rather than in the IdP itself
ALLOWED_EMAIL_DOMAIN=truevaluehub.com
